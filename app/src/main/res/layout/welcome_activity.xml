<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_photobooth_pattern">

    <!-- 1. PHẦN LOGO TO NỔI BẬT NẰM Ở TRÊN -->

    <!-- 2. TIÊU ĐỀ ĐĂNG NHẬP -->

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="280dp"
        android:layout_height="240dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="17dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chụp ảnh xinh - Lưu khoảnh khắc"
        android:textSize="20sp"
        android:textColor="#1E293B"
        android:layout_marginTop="16dp" />

    <!-- Khoảng trống co giãn đẩy nút xuống vị trí cân đối -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 3. PHẦN CÁC NÚT BẤM (CÓ ICON TÍCH HỢP TRONG NÚT) -->

    <!-- Nút Đăng nhập Thành viên (Chứa ic_star) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMember"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="ĐĂNG NHẬP THÀNH VIÊN (MEMBER)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:cornerRadius="39dp"
        app:backgroundTint="#245A68"
        app:icon="@drawable/star"
        app:iconSize="52dp"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconPadding="5dp" />

    <!-- Nút Trải nghiệm nhanh Guest (Chứa ic_camera) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuest"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="TRẢI NGHIỆM NHANH (Guest)"
        android:textSize="15sp"
        android:textColor="#1E293B"
        app:strokeColor="#245A68"
        app:strokeWidth="2dp"
        app:cornerRadius="28dp"
        app:icon="@drawable/camera"
        app:iconSize="42dp"
        app:iconTint="#245A68"
        app:iconGravity="textStart"
        app:iconPadding="10dp" />

    <!-- Dòng chữ Đăng nhập Admin -->
    <TextView
        android:id="@+id/tvAdminLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bạn là Quản trị viên? Đăng nhập Admin"
        android:textColor="#245A68"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>